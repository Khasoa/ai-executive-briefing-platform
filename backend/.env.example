# Application
APP_NAME=Briefly API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
# Local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/briefly

# Railway: set DATABASE_URL to the connection string provided by the PostgreSQL plugin
# DATABASE_URL=postgresql://user:password@host:port/railway

# CORS — comma-separated origins (must match Settings.cors_origins parsing)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO

# Authentication
# AUTH_REQUIRED=false keeps portfolio demo mode: missing Bearer → demo user.
# Set AUTH_REQUIRED=true for multi-user / production API access.
AUTH_REQUIRED=false
SECRET_KEY=dev-only-change-me-briefly-auth-key!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
DEMO_USER_PASSWORD=briefly-demo

# Google OAuth + Calendar + Gmail sync
# Leave blank to keep the portfolio demo working without Google.
# Also enable Calendar API and Gmail API in the Google Cloud project
# (APIs & Services → Library), or sync returns 403 accessNotConfigured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback
# Optional: browser callback 302 target. Empty → JSON TokenResponse.
# OAUTH_SUCCESS_REDIRECT=http://localhost:5173/oauth/callback
OAUTH_STATE_EXPIRE_MINUTES=10
OAUTH_TICKET_EXPIRE_MINUTES=2
# Optional public HTTPS URL for Google Calendar push notifications.
# GOOGLE_CALENDAR_WEBHOOK_URL=https://api.example.com/webhooks/google/calendar
GOOGLE_CALENDAR_SYNC_LOOKBACK_DAYS=7
GOOGLE_CALENDAR_SYNC_LOOKAHEAD_DAYS=90
# Optional Gmail Pub/Sub topic for users.watch (projects/…/topics/…)
# GMAIL_PUBSUB_TOPIC=
GMAIL_SYNC_LOOKBACK_DAYS=14
GMAIL_SYNC_MAX_MESSAGES=500

# OpenAI (Responses API). Leave OPENAI_API_KEY blank to keep curated/demo failover.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30

# Notion OAuth + workspace sync (leave blank to keep demo without Notion API)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/auth/oauth/notion/callback

# GoHighLevel OAuth + opportunity sync (Marketplace app — Location token)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:8000/auth/oauth/gohighlevel/callback

# monday.com OAuth + board item sync (Developer Center app)
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_REDIRECT_URI=http://localhost:8000/auth/oauth/monday/callback

# ClickUp OAuth + task sync (ClickUp API app)
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:8000/auth/oauth/clickup/callback

# n8n orchestration secret for POST /webhooks/n8n/*
# Send as header: X-Briefly-N8N-Secret: <value>
N8N_WEBHOOK_SECRET=
