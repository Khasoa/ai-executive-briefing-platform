# Application
APP_NAME=Briefly API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
# Local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/briefly

# Railway: set DATABASE_URL to the connection string provided by the PostgreSQL plugin
# DATABASE_URL=postgresql://user:password@host:port/railway

# CORS — comma-separated origins (must match Settings.cors_origins parsing)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO

# Authentication
# AUTH_REQUIRED=false keeps portfolio demo mode: missing Bearer → demo user.
# Set AUTH_REQUIRED=true for multi-user / production API access.
AUTH_REQUIRED=false
SECRET_KEY=dev-only-change-me-briefly-auth-key!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
DEMO_USER_PASSWORD=briefly-demo

# Integrations (not yet wired — see docs/roadmap.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OPENAI_API_KEY=
# GHL_API_KEY=
# NOTION_API_KEY=
# N8N_WEBHOOK_SECRET=
